# Build, dependencies and generated output
/target/
/dist/
/build/
/out/
**/node_modules/
**/bin/
**/obj/
**/__pycache__/
*.py[cod]
/.venv/
/venv/
/.dart_tool/
/.flutter-plugins-dependencies
# Test and analysis output
/coverage/
/test-results/
/playwright-report/
# Screenshots emitted when the portal a11y harness runs with an in-tree output dir
/tests/browser/screenshots/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
*.profraw
# Local runtime, secrets and credentials
#
# /.forge/ holds what Forge writes for one machine, not what a project declares:
# `.forge/gate/**` evidence output, `.forge/agents/**` sessions, and
# `.forge/providers.yaml`, whose adapter commands are absolute paths into this
# developer's checkouts. Tracking it would ship paths that are wrong everywhere
# else, so the whole directory stays ignored.
/.forge/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
!.env.*.example
# Transient residue (crash leftovers, editor backups, coverage reports)
*.tmp
*.bak
*.orig
lcov.info
# Local tooling and editor state
/.codegraph/
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.swp
# Local agent runtime state (daemon sockets, logs, locks, conversation transcripts)
/.ariadex/
/.claude/
/.commandcode/
/.qoder/

# templates/ is NOT runtime state and must stay tracked: src/generate/mod.rs
# embeds templates/rust-web-main-rs.txt with include_str! at compile time, so
# ignoring it made a fresh clone fail to build. b85f980 added it here alongside
# the agent directories by mistake.

# Driftwatch local runtime state. This directory holds per-machine state
# (state.db and local caches), never project configuration, so it must
# never be committed. A root-level driftwatch.toml is different: that is
# real project config and IS tracked.
.driftwatch/
