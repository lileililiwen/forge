{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.contracts/job-outcome.schema.json",
  "title": "Job outcome",
  "description": "Terminal outcome of a background job. The result field is a bounded status; new result values require a major version bump.",
  "type": "object",
  "required": ["job_id", "job_type", "started_at", "result"],
  "additionalProperties": true,
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "job_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": ["succeeded", "failed", "partial", "cancelled"]
    },
    "items_processed": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "items_failed": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "tenant_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    }
  }
}
