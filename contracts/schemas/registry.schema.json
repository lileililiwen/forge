{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.contracts/registry.schema.json",
  "title": "Platform contract registry",
  "description": "Lists every shared contract family, its payload schema, supported major versions, status fields, and security-sensitive fields. The validator consults this registry to decide whether a document is forward-compatible.",
  "type": "object",
  "required": ["contracts"],
  "additionalProperties": false,
  "properties": {
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "schema",
          "supported_major_versions",
          "current_version",
          "status_fields",
          "security_sensitive_fields",
          "description",
          "owner_runtime"
        ],
        "properties": {
          "schema": { "type": "string", "minLength": 1 },
          "supported_major_versions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "current_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "security_sensitive_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "owner_runtime": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "narrowing": {
            "type": "object",
            "description": "Optional. Absent means 'not narrowing', so every family is valid as-is. Dropping a major from supported_major_versions MUST be published through this block first: keep state 'declared' while a consumer may still sit on the dropped major, and move it to 'enforced' only once every declaring consumer has migrated. `python3 tools/manifest.py --check-narrowing` fails a publish that is 'enforced' while the manifest still serves a dropped major.",
            "required": ["declared_on", "drops", "previous_supported_major_versions", "notice", "state"],
            "additionalProperties": false,
            "properties": {
              "declared_on": { "type": "string", "format": "date-time" },
              "drops": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "integer", "minimum": 0 }
              },
              "previous_supported_major_versions": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "integer", "minimum": 0 }
              },
              "notice": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["declared", "enforced"] }
            }
          }
        }
      }
    },
    "secret_field_substrings": {
      "type": "array",
      "description": "Field-name substrings (case-insensitive) that indicate a secret or credential. A payload carrying any of these MUST be rejected.",
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
