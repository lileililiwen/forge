<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="platform" value="https://lileililiwen.github.io/forge/nuget/index.json" protocolVersion="3" />
    <add key="platform-legacy" value="https://lileililiwen.github.io/dotnet-platform-libs/nuget/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="platform">
      <package pattern="Platform.*" />
    </packageSource>
    <packageSource key="platform-legacy">
      <package pattern="Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
