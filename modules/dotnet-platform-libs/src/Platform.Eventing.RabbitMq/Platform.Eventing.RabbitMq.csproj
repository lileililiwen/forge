<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Optional RabbitMQ adapter for the platform durable eventing contracts. Confirmed publishing, application-owned topology registration, safe transient/permanent failure classification, and bounded waits; the application owns event schemas, queues, migrations, and retry policy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Eventing.Contracts\Platform.Eventing.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

</Project>
