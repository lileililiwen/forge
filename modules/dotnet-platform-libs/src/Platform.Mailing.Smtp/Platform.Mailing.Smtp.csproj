<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Optional SMTP adapter for Platform.Mailing using MailKit. Normalized send outcomes, explicit TLS/authentication configuration, and attachments; the application owns retries, templates, and delivery records.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Mailing\Platform.Mailing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
