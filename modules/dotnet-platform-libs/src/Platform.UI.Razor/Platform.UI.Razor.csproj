<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Razor static web assets and conventions equivalent to the platform UI contract.</Description>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="wwwroot" />
  </ItemGroup>
</Project>
