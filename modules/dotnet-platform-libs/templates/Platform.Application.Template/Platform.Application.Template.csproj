<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Content-only template pack: no lib output exists for the target framework. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>Platform.Application.Template</PackageId>
    <PackageType>Template</PackageType>
    <Title>Platform application starter template</Title>
    <Description>dotnet new template for a minimal platform-backed ASP.NET Core application with optional test, identity, and persistence variants. Generates detached, application-owned source with no runtime dependency on this pack.</Description>
    <PackageTags>dotnet-new;templates;platform</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\platform-application-starter\**\*" Exclude="..\platform-application-starter\**\bin\**;..\platform-application-starter\**\obj\**" PackagePath="content/" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="$(MSBuildProjectDirectory)/../../README.md" />
  </ItemGroup>

</Project>
