@page
@model StarterApp.Pages.Identity.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot password</h1>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert" role="status">@Model.Message</div>
}
<p class="muted">Enter the email associated with your account. If a matching account exists, we will start a recovery flow.</p>
<form method="post" asp-page="/Identity/Account/ForgotPassword">
    @Html.AntiForgeryToken()
    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" type="email" autocomplete="username" required />
    <div class="actions">
        <button type="submit">Continue</button>
        <a class="muted" href="/Identity/Account/Login">Back to sign in</a>
    </div>
</form>
