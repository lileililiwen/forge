@page
@model StarterApp.Pages.Identity.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert" role="alert">@Model.ErrorMessage</div>
}
<form method="post" asp-page="/Identity/Account/Login">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    @Html.AntiForgeryToken()
    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" type="email" autocomplete="username" required />
    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
    <div class="actions">
        <button type="submit">Sign in</button>
        <a class="muted" href="/Identity/Account/ForgotPassword">Forgot password?</a>
    </div>
</form>
