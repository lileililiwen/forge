{
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "PlatformApplication": {
    "EnvironmentName": "Development",
    "EnableWeb": true,
    "EnableIdentity": false,
    "EnableAdmin": false,
    "EnableBilling": false,
    "EnableAi": false,
    "EnableNotifications": false,
    "EnableSms": false
  },
  "SiteUsers": {
    "Enabled": true,
    "SelfRegistrationEnabled": false,
    "Cookie": {
      "SecurePolicy": "SameAsRequest"
    }
  }
}
