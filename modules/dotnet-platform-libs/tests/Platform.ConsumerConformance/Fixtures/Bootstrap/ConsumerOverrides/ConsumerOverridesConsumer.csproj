<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bootstrap conformance fixture: consumer overrides.

    A net10.0 consumer that opts into the platform bootstrap and
    explicitly overrides every defaulted property. The consumer's
    values must win; the bootstrap must not overwrite them.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Platform.ConsumerConformance.Fixtures.Bootstrap.ConsumerOverrides</RootNamespace>
    <AssemblyName>Platform.ConsumerConformance.Fixtures.Bootstrap.ConsumerOverrides</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformConsumerBootstrap>true</PlatformConsumerBootstrap>
    <PlatformConsumerSourceRoot Condition="'$(PlatformConsumerSourceRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../..'))</PlatformConsumerSourceRoot>
    <PlatformAsSource>true</PlatformAsSource>
    <Nullable>disable</Nullable>
    <LangVersion>10</LangVersion>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DirectoryPackagesPropsPath>$(MSBuildThisFileDirectory)..\Directory.Packages.props</DirectoryPackagesPropsPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BootstrapFixtureSource.cs" Link="BootstrapFixtureSource.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../../../../build/Platform.Consumer.props" />

</Project>
