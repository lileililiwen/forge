<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bootstrap conformance fixture: missing version in package mode.

    A net10.0 consumer that opts into the platform bootstrap with
    PlatformAsSource unset but with PlatformPackageVersion unset. The
    bootstrap must surface a named error naming the version property
    and the switch, and must NOT fall back to a project reference.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Platform.ConsumerConformance.Fixtures.Bootstrap.MissingVersion</RootNamespace>
    <AssemblyName>Platform.ConsumerConformance.Fixtures.Bootstrap.MissingVersion</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformConsumerBootstrap>true</PlatformConsumerBootstrap>
    <DirectoryPackagesPropsPath>$(MSBuildThisFileDirectory)..\Directory.Packages.props</DirectoryPackagesPropsPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BootstrapFixtureSource.cs" Link="BootstrapFixtureSource.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../../../../build/Platform.Consumer.props" />

</Project>
