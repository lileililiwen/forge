<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bootstrap conformance fixture: opt-out.

    A net10.0 consumer that opts into the platform bootstrap and then
    immediately opts out. The bootstrap must be a no-op: no reference,
    no defaults, no diagnostic.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Platform.ConsumerConformance.Fixtures.Bootstrap.OptOut</RootNamespace>
    <AssemblyName>Platform.ConsumerConformance.Fixtures.Bootstrap.OptOut</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformConsumerBootstrap>true</PlatformConsumerBootstrap>
    <PlatformConsumerOptOut>true</PlatformConsumerOptOut>
    <PlatformAsSource>true</PlatformAsSource>
    <PlatformPackageVersion>0.1.0</PlatformPackageVersion>
    <Nullable></Nullable>
    <LangVersion></LangVersion>
    <AnalysisLevel></AnalysisLevel>
    <TreatWarningsAsErrors></TreatWarningsAsErrors>
    <DirectoryPackagesPropsPath>$(MSBuildThisFileDirectory)..\Directory.Packages.props</DirectoryPackagesPropsPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BootstrapFixtureSource.cs" Link="BootstrapFixtureSource.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../../../../build/Platform.Consumer.props" />

</Project>
