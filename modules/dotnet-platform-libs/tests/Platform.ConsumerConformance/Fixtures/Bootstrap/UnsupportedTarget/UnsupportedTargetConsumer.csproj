<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bootstrap conformance fixture: unsupported target framework.

    A consumer that opts into the platform bootstrap with a target
    framework the platform does not publish. The bootstrap must emit
    a named diagnostic naming both the consumer's target and the
    supported target, and must NOT inject a reference or apply
    defaults.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Platform.ConsumerConformance.Fixtures.Bootstrap.UnsupportedTarget</RootNamespace>
    <AssemblyName>Platform.ConsumerConformance.Fixtures.Bootstrap.UnsupportedTarget</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformConsumerBootstrap>true</PlatformConsumerBootstrap>
    <PlatformAsSource>true</PlatformAsSource>
    <DirectoryPackagesPropsPath>$(MSBuildThisFileDirectory)..\Directory.Packages.props</DirectoryPackagesPropsPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BootstrapFixtureSource.cs" Link="BootstrapFixtureSource.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../../../../build/Platform.Consumer.props" />

</Project>
