<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Description>Adoption diagnostics CLI: doctor, inventory, conformance, and preview commands over an explicit project directory. Read-only; never modifies the inspected target.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Platform.Adoption\Platform.Adoption.csproj" />
  </ItemGroup>

</Project>
