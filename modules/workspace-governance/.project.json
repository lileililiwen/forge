      "state": "declared",
      "value": "schema_version 1"
    },
    "toolchain": {
      "state": "declared",
      "value": "python-3.11"
    },
    "artifacts": {
      "state": "unverified"
    },
    "digests": {
      "state": "unverified"
    },
    "sbom": {
      "state": "unverified"
    },
