    },
    "policy": {
      "owner": "platform",
      "evidence_state": "verified",
      "evidence_ref": "scripts/workspace_check.py"
    },
    "evidence": {
      "owner": "platform",
      "evidence_state": "configured",
      "evidence_ref": "docs/capabilities.md"
    },
    "release": {
      "owner": "platform",
      "evidence_state": "declared"
    }
  },
  "release_evidence": {
    "revision": {
      "state": "declared",
      "value": "n/a (governance repo, not deployed)"
