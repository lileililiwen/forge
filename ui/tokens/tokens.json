{
  "$description": "Platform UI design tokens. Primitive values feed semantic intent tokens. This file is the single authoritative source of every design-token value: the generator walks it, holds no values of its own, and the verifier fails on any emitted value that is not reachable from a $value here (design.md D-A, D-B).",
  "color": {
    "slate": { "50": { "$value": "#f8fafc", "$type": "color" }, "100": { "$value": "#f1f5f9", "$type": "color" }, "300": { "$value": "#cbd5e1", "$type": "color" }, "500": { "$value": "#64748b", "$type": "color" }, "700": { "$value": "#334155", "$type": "color" }, "900": { "$value": "#0f172a", "$type": "color" } },
    "blue": { "200": { "$value": "#bfdbfe", "$type": "color", "$description": "Dark-capable accent shade. Used by the dark theme for primary hover and the focus ring." }, "300": { "$value": "#93c5fd", "$type": "color", "$description": "Dark-capable accent shade. Used by the dark theme for primary." }, "600": { "$value": "#1d4ed8", "$type": "color" }, "700": { "$value": "#1e40af", "$type": "color" } },
    "red": { "300": { "$value": "#fca5a5", "$type": "color", "$description": "Dark-capable danger shade." }, "700": { "$value": "#b91c1c", "$type": "color" } },
    "green": { "300": { "$value": "#86efac", "$type": "color", "$description": "Dark-capable success shade." }, "700": { "$value": "#15803d", "$type": "color" } },
    "amber": { "300": { "$value": "#fcd34d", "$type": "color", "$description": "Dark-capable warning shade." }, "700": { "$value": "#b45309", "$type": "color" } },
    "white": { "$value": "#ffffff", "$type": "color" }
  },
  "space": { "1": { "$value": "0.25rem", "$type": "dimension" }, "2": { "$value": "0.5rem", "$type": "dimension" }, "3": { "$value": "0.75rem", "$type": "dimension" }, "4": { "$value": "1rem", "$type": "dimension" }, "6": { "$value": "1.5rem", "$type": "dimension" }, "8": { "$value": "2rem", "$type": "dimension" } },
  "radius": { "sm": { "$value": "0.25rem", "$type": "dimension" }, "md": { "$value": "0.5rem", "$type": "dimension" }, "lg": { "$value": "0.75rem", "$type": "dimension" }, "full": { "$value": "9999px", "$type": "dimension" } },
  "font": { "sans": { "$value": "system-ui, sans-serif", "$type": "fontFamily" }, "body": { "$value": "1rem", "$type": "fontSize" }, "small": { "$value": "0.875rem", "$type": "fontSize" }, "large": { "$value": "1.125rem", "$type": "fontSize" }, "title": { "$value": "1.5rem", "$type": "fontSize" } },
  "semantic": {
    "color": { "background": { "$value": "{color.slate.50}", "$type": "color" }, "surface": { "$value": "{color.white}", "$type": "color" }, "foreground": { "$value": "{color.slate.900}", "$type": "color" }, "muted": { "$value": "{color.slate.100}", "$type": "color" }, "mutedForeground": { "$value": "{color.slate.700}", "$type": "color" }, "primary": { "$value": "{color.blue.600}", "$type": "color" }, "primaryHover": { "$value": "{color.blue.700}", "$type": "color" }, "danger": { "$value": "{color.red.700}", "$type": "color" }, "success": { "$value": "{color.green.700}", "$type": "color" }, "warning": { "$value": "{color.amber.700}", "$type": "color" }, "focusRing": { "$value": "{color.blue.600}", "$type": "color" } }
  },
  "component": {
    "button": { "minHeight": { "$value": "2.5rem", "$type": "dimension" }, "radius": { "$value": "{radius.md}", "$type": "dimension" } },
    "control": { "minHeight": { "$value": "2.5rem", "$type": "dimension" }, "radius": { "$value": "{radius.md}", "$type": "dimension" } }
  },
  "theme": {
    "$description": "Theme override map. Not a token group: each value is an alias to a declared primitive, keyed by the semantic color token it re-points in that mode. The generator holds no token names and no values for a mode, so a dark theme is as themeable as a light one (design.md D-B).",
    "dark": {
      "color": {
        "background": "{color.slate.900}",
        "surface": "{color.slate.700}",
        "foreground": "{color.slate.50}",
        "muted": "{color.slate.700}",
        "mutedForeground": "{color.slate.100}",
        "primary": "{color.blue.300}",
        "primaryHover": "{color.blue.200}",
        "danger": "{color.red.300}",
        "success": "{color.green.300}",
        "warning": "{color.amber.300}",
        "focusRing": "{color.blue.200}"
      }
    }
  }
}
